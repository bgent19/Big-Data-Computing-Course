# =============================================================================
# SD411 Big Data Computing — common.env
# SINGLE SOURCE OF TRUTH for every lab stack on the student VM.
#
# How this is used:
#   scripts/sync_env.sh stamps a copy of THIS file into each labN/ directory
#   as labN/.env . Docker Compose auto-reads .env for ${VAR} substitution, so
#   every lab compose file references these names instead of hardcoding tags,
#   credentials, ports, or sizing. Change a value here, re-run sync_env.sh,
#   and all labs move in lockstep.
#
# Rule: NO lab compose file may hardcode an image tag, credential, bucket
#       name, or worker size. If you find one, lift it into this file.
# =============================================================================

# ---- Container images (pinned) ---------------------------------------------
# Spark: official Apache image. Bitnami was removed from Docker Hub Aug 2025;
# any bitnami/spark tag now 404s. Labs 1-3 compose files still say bitnami and
# MUST be migrated to this var (see CHANGELOG_entry_vm_base.md, finding F1).
SPARK_IMAGE=apache/spark:3.5.3-python3

# Hadoop (Lab 1 HDFS namenode/datanode).
HADOOP_IMAGE=apache/hadoop:3.3.6

# MinIO server + mc client.
# !!! PLACEHOLDER TAGS — reconcile against lab0/docker-compose.yml and confirm
# !!! on Docker Hub before publishing (CHANGELOG finding F2). A tag drift here
# !!! silently breaks persisted Week 1 MinIO volumes across labs.
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z

# Optional locally-built Spark image with the USNA root CA baked into the Java
# truststore (see Dockerfile.spark-usna). Leave SPARK_IMAGE pointed at the
# upstream image unless you adopt the derived-image path course-wide.
SPARK_USNA_IMAGE=sd411/spark-usna:3.5.3

# ---- MinIO / S3A credentials and layout ------------------------------------
# These MUST be identical across all labs or persisted volumes break.
MINIO_ROOT_USER=sd411admin
MINIO_ROOT_PASSWORD=sd411password
S3_BUCKET=sd411
S3_LANDING_BUCKET=landing
S3_ENDPOINT=http://minio:9000

# ---- Cross-lab fact-table contract -----------------------------------------
# lab06 (Partitioning) WRITES this prefix; lab07 (Joins) READS it. They must
# never disagree, so the path lives here and both labs resolve it from the
# stamped .env. If lab06's writer moves, change it HERE, not in either lab.
# Full path is s3a://${S3_BUCKET}/${FACT_PREFIX}
FACT_PREFIX=fact/pitches

# ---- S3A connector JARs (host-fetched; see scripts/download_jars.sh) -------
# Versions Hadoop 3.3.4 was built against. Mismatches surface as
# NoSuchMethodError at RUNTIME, not load time. Move these together.
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_BUNDLE_VERSION=1.12.262

# ---- Worker sizing (course-wide; NOT a per-student knob) -------------------
# Assumes >=8 GB student VMs. If the issued VMs are 4 GB, drop WORKER_MEM
# course-wide here (e.g. 1500m) rather than editing individual labs.
# See CHANGELOG finding F3 — confirm issued VM specs before term.
WORKER_MEM=2g
WORKER_CORES=2
SPARK_DAEMON_MEM=512m

# ---- Host ports ------------------------------------------------------------
# Every lab reuses these, so only ONE sd411 stack can run at a time.
# scripts/sd411_down_all.sh clears a stale stack before switching labs.
PORT_SPARK_MASTER_UI=8080
PORT_SPARK_WORKER_UI=8081
PORT_SPARK_MASTER=7077
PORT_DRIVER_UI=4040
PORT_DRIVER_UI_ALT=4041
PORT_MINIO_API=9000
PORT_MINIO_CONSOLE=9001
PORT_HDFS_NN_UI=9870

# ---- Trust / network workarounds (USNA TLS interception) -------------------
# The institutional proxy MITMs TLS, so the system CA bundle is the only
# trust store that already contains the USNA root. pybaseball (Python) reads
# this; Java reads its own cacerts (handled by the host-fetched JARs or the
# derived image). See scripts/fix_trust_stores.sh.
SYSTEM_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# ---- Shared on-VM paths ----------------------------------------------------
# Provisioned once; labs read the seed and JARs from these stable locations.
SD411_HOME=/opt/sd411
SD411_DATA=/opt/sd411/data
SD411_JARS=/opt/sd411/jars
SD411_REPO=/opt/sd411/repo
SEED_CSV=statcast_2025.csv
SEED_CSV_LARGE=statcast_2015_2025.csv

# ---- Dataset sanity floors (enforced by seed + verify scripts) -------------
# Single-season floors, used by labs 2/3/5 which read ${SEED_CSV}.
SEED_MIN_MB=100
SEED_MIN_ROWS=600000
# Multi-season floors, used by labs 6/7/8 which read ${SEED_CSV_LARGE}. Sized to
# catch a truncated/partial multi-season pull (11 seasons ~= 7.7M rows / ~4.8 GB;
# 2020 was a 60-game season, so do not set these at a naive 11x).
SEED_MIN_MB_LARGE=3000
SEED_MIN_ROWS_LARGE=5000000
SEED_SEASON_START=2025-03-27
SEED_SEASON_END=2025-09-28

# ---- Kafka (Module 3: lab09, lab10, lab11) ---------------------------------
# Official Apache image, KRaft mode, no ZooKeeper. Bitnami is not an option
# (finding F1: bitnami/* was pulled from Docker Hub Aug 2025). Confluent's
# images are a second registry and a second version story for no benefit at
# this scale.
KAFKA_IMAGE=apache/kafka:3.9.0

# KRaft requires a cluster UUID at format time. Any valid base64 22-char UUID
# works; it is fixed here so a re-created volume does not silently become a
# different cluster. Regenerate with: kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=SD411KafkaClusterAA1

# Bootstrap address used by every in-network client (container to container).
KAFKA_BOOTSTRAP=kafka:9092

# Host-published listener. Nothing else in common.env uses 29092, so this does
# not collide with the one-stack-at-a-time port set above.
PORT_KAFKA_EXTERNAL=29092

# Broker JVM heap. Same reasoning as WORKER_MEM: one course-wide knob, sized
# for the >=8 GB VM assumption in open item F3. If the issued VMs are 4 GB,
# drop this to 384m here, not in the lab file. Quoted because the value
# contains a space and several tools read this file line by line.
KAFKA_HEAP_OPTS="-Xmx512m -Xms512m"

# How often the broker checks for expired segments. Broker default is 300000
# (5 min), which makes the lab09 Part 5 retention demonstration impossible to
# observe inside a 120-minute period.
KAFKA_RETENTION_CHECK_MS=10000

# ---- Module 3 stream source ------------------------------------------------
# GitHub Archive hourly event file, staged by vm-base provisioning. One hour
# is enough: a 2026 hour carries several hundred thousand events, and
# make_stream.py reads lazily and stops early, so file size does not matter.
GH_ARCHIVE_HOUR=2026-03-04-15
GH_ARCHIVE_FILE=2026-03-04-15.json.gz
STREAM_DIR=/opt/sd411/data/stream
STREAM_FILE=gh_events.tsv
STREAM_EVENTS=200000
STREAM_MIN_LINES=60000

# ---- Spark-Kafka connector JARs (lab09 stretch; REQUIRED for lab10/lab11) ---
# Same host-fetch rule as the S3A JARs: the USNA proxy MITMs TLS, so Ivy
# cannot resolve --packages and these are staged into ${SD411_JARS} by
# scripts/download_jars.sh. Spark 3.5.3 is built against kafka-clients 3.4.1;
# these four move together and a mismatch surfaces as NoSuchMethodError at
# runtime, not at load time.
SPARK_KAFKA_VERSION=3.5.3
KAFKA_CLIENTS_VERSION=3.4.1
COMMONS_POOL2_VERSION=2.11.1

# ---- Lab 10: Wikipedia Pageviews windowing feed -----------------------------
# Provisioned once per VM image by provision/fetch_pageviews.sh and
# provision/prepare_pageviews.py. Students never fetch anything.
#
# PV_WEEK_START must be a date whose hour 00 UTC starts the feed. Window
# boundaries align to the Unix epoch, so a feed that starts at 00:00 UTC makes
# the 3, 6, and 24 hour window counts come out to exact integers, which is what
# makes Part 1's predictions gradeable. Do not start the feed mid-day.
PV_WEEK_START=2026-02-02
PV_HOURS=168
PV_MIN_VIEWS=50
PV_MIN_SHARDS=168

# Out-of-order injection. Reproducible given the seed; changing any of these
# invalidates the shard spans in the Lab 10 instructor key section 3.1.
PV_LATE_FRACTION=0.08
PV_LATE_MAX_SHIFT=3
PV_SEED=411

# Session-window key floor. Bounds the open-session key space in Part 3 so a
# 2 GB worker survives it. See INSTRUCTOR_KEY.md section 5, triage item 10.
PV_SESSION_MIN_VIEWS=500

# Streaming replay pacing. Lower MAX_FILES_PER_TRIGGER for more batches on the
# state curve, raise it if Part 1 overruns on the issued VM.
MAX_FILES_PER_TRIGGER=8
TRIGGER_SECONDS=1

# Paths. PV_DIR is a container path and a file:// URI on purpose: the streaming
# file source reads locally from the read-only mount, not through S3A.
PV_DIR=file:///opt/lab10/pageviews
CHK_PREFIX=chk/lab10
ORACLE_PREFIX=lab10/oracle

# Driver/executor working directory. NOT a free choice: this MUST equal the
# mount point of the spark-work named volume in docker-compose.base.yml
# (working_dir and the volumes: entry on both spark-master and spark-worker).
# Anything written outside that path lands in the container's writable layer
# and is destroyed by `docker compose down`, which silently loses lab05's plan
# files and lab10's metrics JSONL. The stock apache/spark image defaults to
# /opt/spark/work-dir; the base compose deliberately relocates it, so do not
# "restore" that value. Used by lab05 (PLAN_DIR) and lab10 (METRICS_DIR).
SPARK_WORK_DIR=/opt/spark/work

# ---- lab11: streaming aggregation with state -------------------------------
# Runtime knobs read by the lab11 Python scripts and produce.sh as defaults,
# not by the compose, so a missed append cannot stop `docker compose up`. They
# live here only so the whole class runs the same topic, window grid,
# watermark, and crash point, which is what makes the predictions gradeable.
# lab11's broker names (KAFKA_IMAGE, KAFKA_HEAP_OPTS, PORT_KAFKA_EXTERNAL) come
# from the Kafka block above; lab11 does NOT redefine them.
#
# Topic lab11 produces into and both the streaming query and the oracle read
# from. ONE partition (set by produce.sh at create time): this lab is about
# state and recovery, not skew (that was lab08 and lab09). One partition makes
# the committed offset a single number a student reads straight out of the
# checkpoint.
LAB11_TOPIC=pitches
LAB11_BROKER=broker:9092

# Event-time window grid and the GENEROUS watermark used everywhere except the
# Part 1 drop sub-experiment. 180 > the producer's 90 s late tail, so the
# generous run drops nothing and the streaming sink equals the closed-window
# oracle. Part 1 passes a TIGHT allowance on the CLI (--action drops
# --watermark 30); 30 < 90, so it abandons the entire late tail. The two
# numbers straddle the tail on purpose.
LAB11_WINDOW_SECONDS=60
LAB11_WATERMARK_SECONDS=180

# Chunk the bounded topic into several micro-batches so there is a batch 3 to
# crash on and so state builds up across batches instead of in one shot. With
# ~20000 records this yields 6 triggers: 5 with data, then one no-data batch
# that exists only to apply the final watermark and emit the last windows.
LAB11_MAX_OFFSETS_PER_TRIGGER=4000

# Part 1 ONLY (--action drops). Spark filters late records against a watermark
# that lags the data by about one micro-batch of event time, so the late tail is
# abandoned only when (batch event-time span) + allowance < the tail's lateness
# (90 s). At 4000 the span is 4000 * 180 ms = 720 s and NOTHING is ever dropped,
# at any allowance; at 200 the span is 36 s and 36 + 30 < 90 drops the whole
# 1600-record tail. Keep in lockstep with the generator's --late-lateness-seconds
# and with LAB11_WATERMARK_SECONDS.
LAB11_DROPS_MAX_OFFSETS=200

# Shuffle partitions, and therefore state-store partitions and files written per
# micro-batch. Spark's default of 200 has every batch write 200 state files and
# 200 tiny Parquet parts; on a single-worker VM that dominates the runtime of the
# 100-batch Part 1 run (4 min at 200, under 1 min at 8). This value is recorded
# in the streaming checkpoint, so changing it only takes effect after a reset.
LAB11_SHUFFLE_PARTITIONS=8

# Deterministic crash target for Part 2 and Part 3. foreachBatch raises AFTER
# the batch write and BEFORE the offset commit when it sees this batch id, so
# every student crashes at the same logical point instead of racing a manual
# kill.
LAB11_CRASH_BATCH=3

# Producer pacing into the topic: RATE records then sleep 1 (lab09 replay
# shape). Pacing does not affect the event-time result; it only keeps the
# broker log readable and gives the streaming query several micro-batches to
# chew on.
LAB11_PRODUCE_RATE=2000
